#!/usr/bin/env bash

# Terminal control functions
NORM(){ echo -en "\033[?12l\033[?25h";}

SHOW_SIG=true
FORCE_FONT=""
DO_CLEAR=true
DO_CIVIS=true
IS_PREVIEW=false

# Parse arguments
while [[ "$#" -gt 0 ]]; do
    case "$1" in
        --no-sig) SHOW_SIG=false ;;
        --no-clear) DO_CLEAR=false ;;
        --no-civis) DO_CIVIS=false ;;
        --preview) IS_PREVIEW=true; SHOW_SIG=false ;;
        --font) shift; FORCE_FONT="$1" ;;
        -*) ;; 
        *) [[ -z "$NAME" ]] && NAME="$1" ;;
    esac
    shift
done

# Load preference if name not passed
if [[ -z "${NAME// /}" ]]; then
    PREF_FILE="$HOME/.promptify/userdata/prefs.conf"
    [[ -f "$PREF_FILE" ]] || PREF_FILE="$HOME/.username"
    if [[ -f "$PREF_FILE" ]]; then
        NAME=$(grep "^NAME=" "$PREF_FILE" | head -1 | cut -d= -f2- | tr -d '"')
    fi
fi
[[ -z "${NAME// /}" ]] && NAME="Promptify"

[[ "$DO_CLEAR" == "true" ]] && printf "\033[2J\033[H" >&2
[[ "$DO_CIVIS" == "true" ]] && tput civis >&2

# 1. Setup Logic
TERM_W=$(tput cols)
P_DIR="$PROMPTIFY_DIR"
[[ -z "$P_DIR" ]] && P_DIR="$HOME/.promptify"
# New APK-style layout keeps assets inside core/assets; the old flat layout
# (~/.promptify/assets) is still resolved for legacy installs.
[[ -d "$P_DIR/core/assets" ]] && P_DIR="$P_DIR/core"
F_SHADOW="$P_DIR/assets/ASCII-Shadow.flf"

# figlet must actually run (a broken PATH shim, e.g. the host Termux's figlet
# inside proot-distro, would produce an empty banner). Fall back to a plain
# centered line when it's missing or unusable.
if ! command -v figlet &> /dev/null || ! figlet -v &>/dev/null; then
    CLEAN_LEN=$(( ${#NAME} + 8 ))
    OFFSET=$(( (TERM_W - CLEAN_LEN) / 2 ))
    [[ $OFFSET -lt 0 ]] && OFFSET=0
    printf "\r%${OFFSET}s\033[1;35m--- %s ---\033[0m\n" "" "$NAME" >&2
    return 0 2>/dev/null || exit 0
fi

# 2. Font Selection (V1 Style)
KERN=""
[[ ${#NAME} -lt 7 ]] && KERN="-k"

# Pick a random style from the full pool (fresh on every banner draw)
pick_random_font() {
    local pool=("$F_SHADOW" "standard" "slant" "banner" "smpoison" "graffiti")
    echo "${pool[$((RANDOM % ${#pool[@]}))]}"
}

if [[ -n "$FORCE_FONT" ]]; then
    case "$FORCE_FONT" in
        "shadow")   USE_FONT="$F_SHADOW" ;;
        "big")      USE_FONT="big"; KERN="" ;;
        "std")      USE_FONT="standard"; KERN="" ;;
        "slant")    USE_FONT="slant"; KERN="" ;;
        "banner")   USE_FONT="banner"; KERN="" ;;
        "smpoison") USE_FONT="smpoison"; KERN="" ;;
        "graffiti") USE_FONT="graffiti"; KERN="" ;;
        "random")   USE_FONT="$(pick_random_font)" ;;
        *)          USE_FONT="$F_SHADOW" ;;
    esac
else
    PREF_FILE="$HOME/.promptify/userdata/prefs.conf"
    [[ -f "$PREF_FILE" ]] || PREF_FILE="$HOME/.username"
    if [[ -f "$PREF_FILE" ]]; then
        PREF_FONT=$(grep "^FONT=" "$PREF_FILE" | head -1 | cut -d= -f2- | tr -d '"')
    fi
    case "${PREF_FONT:-auto}" in
        "shadow")   USE_FONT="$F_SHADOW" ;;
        "big")      USE_FONT="big"; KERN="" ;;
        "std")      USE_FONT="standard"; KERN="" ;;
        "slant")    USE_FONT="slant"; KERN="" ;;
        "banner")   USE_FONT="banner"; KERN="" ;;
        "smpoison") USE_FONT="smpoison"; KERN="" ;;
        "graffiti") USE_FONT="graffiti"; KERN="" ;;
        *)          USE_FONT="$(pick_random_font)"; KERN="" ;;
    esac
fi

# FONT_DESCENT tracks figlet's descent layout so blank trailing rows that
# carry no real glyph (descent-0 fonts like shadow) can be trimmed back to
# the old centered look while other fonts keep their constant box height.
case "$USE_FONT" in
    "$F_SHADOW")      FONT_DESCENT=0 ;;
    "big"|"smpoison") FONT_DESCENT=2 ;;
    *)                FONT_DESCENT=1 ;;
esac

# Capture figlet output and check fit (V1 Core Logic)
check_fit() {
    local f_kern="$1"
    local f_font="$2"
    local f_name="$3"
    local f_max_w="$4"
    local max_w=0
    
    mapfile -t RAW_LINES < <(figlet ${f_kern:+"$f_kern"} -f "$f_font" -w 1000 "$f_name" 2>/dev/null)
    for line in "${RAW_LINES[@]}"; do
        [[ ${#line} -gt $max_w ]] && max_w=${#line}
    done
    [[ $max_w -le $((f_max_w - 12)) ]]
}

# Auto-fit logic (V1 Logic)
if ! check_fit "$KERN" "$USE_FONT" "$NAME" "$TERM_W"; then
    if [[ "$USE_FONT" != "standard" ]]; then
        USE_FONT="standard"
        KERN=""
        FONT_DESCENT=1
        mapfile -t RAW_LINES < <(figlet -f "standard" -w 1000 "$NAME" 2>/dev/null)
    fi
fi

# Find Min Leading Space and Max Width
MIN_LEAD=999
MAX_LINE_W=0
for line in "${RAW_LINES[@]}"; do
    [[ -z "${line// /}" ]] && continue
    stripped="${line#"${line%%[! ]*}"}"
    lead_count=$(( ${#line} - ${#stripped} ))
    [[ $lead_count -lt $MIN_LEAD ]] && MIN_LEAD=$lead_count
done
[[ $MIN_LEAD -eq 999 ]] && MIN_LEAD=0

# Tighten lines: strip shared leading space and trailing whitespace, but KEEP
# every figlet layout row. figlet always emits exactly `height` rows per font,
# so keeping them all makes the box height constant per font — words with or
# without descender letters ('g','j','p','y','f') render identically tall.
FINAL_LINES=()
for line in "${RAW_LINES[@]}"; do
    line="${line:$MIN_LEAD}"
    line="${line%"${line##*[![:space:]]}"}"
    FINAL_LINES+=("$line")
    [[ ${#line} -gt $MAX_LINE_W ]] && MAX_LINE_W=${#line}
done

# Descent-0 fonts (e.g. shadow) always emit a trailing blank layout row with
# no glyph meaning; trim it so the glyph block regains the old centered look.
if [[ "$FONT_DESCENT" == "0" ]]; then
    while [[ ${#FINAL_LINES[@]} -gt 0 ]] && [[ -z "${FINAL_LINES[-1]// /}" ]]; do
        unset 'FINAL_LINES[-1]'
    done
    FINAL_LINES=("${FINAL_LINES[@]}")
fi

# 3. Box Dimensions (CONTENT-BASED: hugs text on any terminal width)
# Keep the base padding at +14 for a bit of breathing room.
WIDTH=$((MAX_LINE_W + 14))

# Previews need stability, so we use a wider fixed range
if [[ "$IS_PREVIEW" == "true" ]]; then
    [[ $WIDTH -lt 72 ]] && WIDTH=72
    [[ $WIDTH -gt 78 ]] && WIDTH=78
fi

# ABSOLUTE LIMIT: Ensure it never exceeds terminal width but contains content
if [[ $WIDTH -gt $((TERM_W - 2)) ]]; then
    WIDTH=$((TERM_W - 2))
fi

# CRUCIAL: Box MUST be at least 4 chars wider than content to prevent "fading" through borders
if [[ $WIDTH -lt $((MAX_LINE_W + 4)) ]]; then
    WIDTH=$((MAX_LINE_W + 4))
fi

[[ $WIDTH -lt 40 ]] && WIDTH=40

# Narrow screens: fall back to a compact centered line instead of a broken,
# wrapped box. Previews are exempt so font previews always show the full box.
if [[ "$IS_PREVIEW" == "false" && $WIDTH -gt $((TERM_W - 2)) ]]; then
    CLEAN_LEN=$(( ${#NAME} + 8 ))
    OFFSET=$(( (TERM_W - CLEAN_LEN) / 2 ))
    [[ $OFFSET -lt 0 ]] && OFFSET=0
    printf "\r%${OFFSET}s\033[1;35m--- %s ---\033[0m\n" "" "$NAME" >&2
    printf "\n" >&2
    [[ "$DO_CIVIS" == "true" ]] && NORM
    exit 0
fi

# Padding to center content inside box (Balanced Centering)
# Add 1 before division to round up, which often looks more centered on terminals
BLOCK_PAD_L=$(( (WIDTH - 2 - MAX_LINE_W + 1) / 2 ))
[[ $BLOCK_PAD_L -lt 0 ]] && BLOCK_PAD_L=0

# Screen offset for box centering
OFFSET=$(( (TERM_W - WIDTH) / 2 ))
[[ $OFFSET -lt 0 ]] && OFFSET=0
SPACER=$(printf "%${OFFSET}s" "")

# lolcat must actually run: a Ruby upgrade can wipe the gem and leave a dead
# lolcat on PATH that passes `command -v` but fails every call. When it's not
# usable, fall back to a native ANSI gradient so the banner is always colorful.
lolcat_works() {
    command -v lolcat &> /dev/null && lolcat --version &>/dev/null
}

# Native rainbow fallback — a faithful port of lolcat's numeric_rainbow()
# (busyloop/lolcat lib/lolcat/lol.rb): per char,
#   phase = freq * (seed_line + i/spread)  with freq=0.1, spread=3.0
#   r = sin(phase)+128 etc., seed random 0-255 per run, +1 per line.
# Same smooth banding, same random phase shift every render — no external gem.
gradient_block() {
    local lines=("$@")
    local seed=$(( RANDOM % 256 ))
    local r c os_off idx ch rv gv bv
    for ((r=0; r<${#lines[@]}; r++)); do
        os_off=$(( seed + r + 1 ))
        for ((c=0; c<${#lines[r]}; c++)); do
            ch="${lines[r]:c:1}"
            # round(deg/2) for a 2-degree sine table, deg = (3*os+i)*180/(pi*30)
            idx=$(( ((95493 * (3 * os_off + c)) + 5000) / 100000 ))
            idx=$(( idx % 180 ))
            if [[ "$TRUECOLOR" == "true" ]]; then
                rv=${SIN_R[idx]}; gv=${SIN_G[idx]}; bv=${SIN_B[idx]}
                printf "\033[38;2;%d;%d;%dm%s\033[0m" "$rv" "$gv" "$bv" "$ch"
            else
                printf "\033[38;5;%sm%s\033[0m" "${CUBE[idx]}" "$ch"
            fi
        done
        printf "\n"
    done
}

TRUECOLOR=false
[[ "${COLORTERM:-}" == *truecolor* || "${COLORTERM:-}" == *24bit* ]] && TRUECOLOR=true

# Precomputed sin(2-degree steps)*127+128 for red, and the green/blue channels are
# the same wave shifted by 120°/240° (i.e. table index +60/+120). CUBE holds the
# nearest 256-color index per step for non-truecolor terminals.
SIN_R=( 128 132 137 141 146 150 154 159 163 167 171 176 180 184 188 192 195 199 203 206 210 213 216 219 222 225 228 231 233 236 238 240 242 244 246 247 249 250 251 252 253 254 254 255 255 255 255 255 254 254 253 252 251 250 249 247 246 244 242 240 238 236 233 231 228 225 222 219 216 213 210 206 203 199 195 192 188 184 180 176 171 167 163 159 154 150 146 141 137 132 128 124 119 115 110 106 102 97 93 89 85 80 76 72 68 64 61 57 53 50 46 43 40 37 34 31 28 25 23 20 18 16 14 12 10 9 7 6 5 4 3 2 2 1 1 1 1 1 2 2 3 4 5 6 7 9 10 12 14 16 18 20 23 25 28 31 34 37 40 43 46 50 53 57 61 64 68 72 76 80 85 89 93 97 102 106 110 115 119 124 )
SIN_G=( 238 236 233 231 228 225 222 219 216 213 210 206 203 199 195 192 188 184 180 176 171 167 163 159 154 150 146 141 137 132 128 124 119 115 110 106 102 97 93 89 85 80 76 72 68 65 61 57 53 50 46 43 40 37 34 31 28 25 23 20 18 16 14 12 10 9 7 6 5 4 3 2 2 1 1 1 1 1 2 2 3 4 5 6 7 9 10 12 14 16 18 20 23 25 28 31 34 37 40 43 46 50 53 57 61 65 68 72 76 80 85 89 93 97 102 106 110 115 119 124 128 132 137 141 146 150 154 159 163 167 171 176 180 184 188 191 195 199 203 206 210 213 216 219 222 225 228 231 233 236 238 240 242 244 246 247 249 250 251 252 253 254 254 255 255 255 255 255 254 254 253 252 251 250 249 247 246 244 242 240 )
SIN_B=( 18 16 14 12 10 9 7 6 5 4 3 2 2 1 1 1 1 1 2 2 3 4 5 6 7 9 10 12 14 16 18 20 23 25 28 31 34 37 40 43 46 50 53 57 61 64 68 72 76 80 85 89 93 97 102 106 110 115 119 124 128 132 137 141 146 150 154 159 163 167 171 176 180 184 188 191 195 199 203 206 210 213 216 219 222 225 228 231 233 236 238 240 242 244 246 247 249 250 251 252 253 254 254 255 255 255 255 255 254 254 253 252 251 250 249 247 246 244 242 240 238 236 233 231 228 225 222 219 216 213 210 206 203 199 195 191 188 184 180 176 171 167 163 159 154 150 146 141 137 132 128 124 119 115 110 106 102 97 93 89 85 80 76 72 68 65 61 57 53 50 46 43 40 37 34 31 28 25 23 20 )
CUBE=( 154 154 154 154 148 148 148 148 148 148 148 148 184 184 184 184 184 184 184 178 178 178 178 178 178 178 178 214 214 214 214 208 208 208 209 209 209 209 209 209 209 209 203 203 203 203 203 203 203 204 204 204 204 204 204 204 204 198 198 198 199 199 199 199 163 163 163 163 163 163 163 163 164 164 164 164 164 164 164 128 128 128 128 128 128 128 128 129 129 129 129 93 93 93 99 99 99 99 99 99 99 99 63 63 63 63 63 63 63 69 69 69 69 69 69 69 69 33 33 33 39 39 39 39 38 38 38 38 38 38 38 38 44 44 44 44 44 44 44 43 43 43 43 43 43 43 43 49 49 49 49 48 48 48 84 84 84 84 84 84 84 84 83 83 83 83 83 83 83 119 119 119 119 119 119 119 119 118 118 118 )

# Colorize with lolcat (native rainbow fallback when missing/broken)
if lolcat_works; then
    COLORED_BLOCK=$(printf "%s\n" "${FINAL_LINES[@]}" | lolcat -f 2>/dev/null)
    if [[ -n "$COLORED_BLOCK" ]]; then
        mapfile -t COLORED_LINES <<< "$COLORED_BLOCK"
    else
        mapfile -t COLORED_LINES < <(gradient_block "${FINAL_LINES[@]}")
    fi
else
    mapfile -t COLORED_LINES < <(gradient_block "${FINAL_LINES[@]}")
fi

# 4. Final Drawing
BOX_CLR="\033[1;34m" 
RESET="\033[0m"

H_LINE=""
for ((i=0; i<WIDTH-2; i++)); do
    H_LINE+="═"
done

printf "%b%b╔%s╗%b\n" "$SPACER" "$BOX_CLR" "$H_LINE" "$RESET" >&2

for i in "${!FINAL_LINES[@]}"; do
    line="${FINAL_LINES[i]}"
    colored_line="${COLORED_LINES[i]:-$line}"
    line_len=${#line}
    
    pad_r=$(( WIDTH - 2 - BLOCK_PAD_L - line_len ))
    [[ $pad_r -lt 0 ]] && pad_r=0
    
    # Robust Surgical Printing
    printf "%b%b║%b" "$SPACER" "$BOX_CLR" "$RESET" >&2
    printf "%*s" "$BLOCK_PAD_L" "" >&2
    printf "%s" "$colored_line" >&2
    printf "%*s" "$pad_r" "" >&2
    printf "%b║%b\n" "$BOX_CLR" "$RESET" >&2
done

printf "%b%b╚%s╝%b\n" "$SPACER" "$BOX_CLR" "$H_LINE" "$RESET" >&2

if [[ "$SHOW_SIG" == "true" ]]; then
    SIG_TEXT="Powered by Promptify ⚡︎"
    SIG_OFFSET=$(( OFFSET + WIDTH - ${#SIG_TEXT} - 2 ))
    [[ $SIG_OFFSET -lt 0 ]] && SIG_OFFSET=0
    printf "%*s\033[1;35mPowered by \033[1;36mPromptify \033[1;33m⚡︎\033[0m\n" "$SIG_OFFSET" "" >&2
fi

printf "\n" >&2
if [[ "$DO_CIVIS" == "true" ]]; then
    NORM
fi
exit 0
